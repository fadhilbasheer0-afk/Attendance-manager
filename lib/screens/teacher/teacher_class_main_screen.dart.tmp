class TeacherClassMainScreen extends StatelessWidget {
  const TeacherClassMainScreen({
    super.key,
    required this.className,
    required this.medium,
    required this.branchId,
    required this.title,
    required this.whatsappLink,
    required this.institutionId,
  });

  final String className;
  final String medium;
  final String branchId;
  final String title;
  final String whatsappLink;
  final String institutionId;

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 5,
      child: Scaffold(
        appBar: AppBar(
          title:
              Text(title, style: const TextStyle(fontWeight: FontWeight.bold)),
          bottom: const TabBar(
            isScrollable: true,
            tabs: [
              Tab(icon: Icon(Icons.people), text: 'Students'),
              Tab(icon: Icon(Icons.fact_check), text: 'Attendance'),
              Tab(icon: Icon(Icons.calendar_month), text: 'Monthly Report'),
              Tab(icon: Icon(Icons.grade), text: 'Marks'),
              Tab(icon: Icon(Icons.payments), text: 'Fees'),
            ],
          ),
        ),
        body: TabBarView(
          children: [
            _StudentsTab(
                className: className, medium: medium, branchId: branchId),
            _AttendanceTab(
                className: className,
                medium: medium,
                branchId: branchId,
                whatsappLink: whatsappLink),
            _MonthlyTab(
                className: className, medium: medium, branchId: branchId),
            _MarksTab(
                className: className, medium: medium, branchId: branchId, institutionId: institutionId),
            _FeesTab(
                className: className, medium: medium, branchId: branchId, institutionId: institutionId),
          ],
        ),
      ),
    );
  }
}

// ==========================================
// 1. STUDENTS TAB & DETAIL SCREEN
// ==========================================
class _StudentsTab extends StatelessWidget {
  const _StudentsTab(
      {required this.className, required this.medium, required this.branchId});
  final String className;
  final String medium;
  final String branchId;

  @override
  Widget build(BuildContext context) {
    final repo = context.read<FirestoreRepository>();
    return StreamBuilder<List<Student>>(
      stream: repo.watchStudentsForClass(
          branchId: branchId, className: className, medium: medium),
      builder: (context, snap) {
        if (snap.hasError) return Center(child: Text('Error: ${snap.error}'));
        if (!snap.hasData) {
          return const Center(child: CircularProgressIndicator());
        }
        final students = snap.data!;
        if (students.isEmpty) {
          return const Center(child: Text('No students in this class yet.'));
        }

        return ListView.separated(
          padding: const EdgeInsets.all(16),
          itemCount: students.length,
          separatorBuilder: (_, __) => const SizedBox(height: 10),
          itemBuilder: (context, i) {
            final s = students[i];
            return Card(
              child: ListTile(
                leading: CircleAvatar(
                  backgroundImage:
                      s.photoUrl.isNotEmpty ? NetworkImage(s.photoUrl) : null,
                  child: s.photoUrl.isEmpty ? const Icon(Icons.person) : null,
                ),
                title: Text(s.name,
                    style: const TextStyle(fontWeight: FontWeight.bold)),
                subtitle: Text(
                    'Admission: ${s.admissionNumber} | Mobile: ${s.mobile}'),
                trailing: const Icon(Icons.chevron_right),
                onTap: () {
                  Navigator.of(context).push(
                    MaterialPageRoute(
                      builder: (_) =>
                          _StudentDetailScreen(student: s, branchId: branchId),
                    ),
                  );
                },
              ),
            );
          },
        );
      },
    );
  }
}

class _StudentDetailScreen extends StatelessWidget {
  const _StudentDetailScreen({required this.student, required this.branchId});
  final Student student;
  final String branchId;

  @override
  Widget build(BuildContext context) {
    final repo = context.read<FirestoreRepository>();
    return Scaffold(
      appBar: AppBar(title: Text(student.name)),
      body: ListView(
        padding: const EdgeInsets.all(20),
        children: [
          Center(
            child: CircleAvatar(
              radius: 64,
              backgroundImage: student.photoUrl.isNotEmpty
                  ? NetworkImage(student.photoUrl)
                  : null,
              child: student.photoUrl.isEmpty
                  ? const Icon(Icons.person, size: 64)
                  : null,
            ),
          ),
          const SizedBox(height: 24),
          Card(
            child: Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text('Profile Information',
                      style: Theme.of(context)
                          .textTheme
                          .titleLarge
                          ?.copyWith(fontWeight: FontWeight.bold)),
                  const Divider(height: 24),
                  _InfoRow(label: 'Full Name', value: student.name),
                  const SizedBox(height: 12),
                  _InfoRow(
                      label: 'Admission No', value: student.admissionNumber),
                  const SizedBox(height: 12),
                  _InfoRow(label: 'Mobile No', value: student.mobile),
                  const SizedBox(height: 12),
                  _InfoRow(label: 'Class', value: student.className),
                  const SizedBox(height: 12),
                  _InfoRow(label: 'Medium', value: student.medium),
                ],
              ),
            ),
          ),
          const SizedBox(height: 24),
          Row(
            children: [
              Expanded(
                child: FilledButton.icon(
                  style: FilledButton.styleFrom(
                      backgroundColor: Colors.green,
                      padding: const EdgeInsets.symmetric(vertical: 16)),
                  onPressed: () async {
                    final uri = Uri.parse('tel:${student.mobile}');
                    try {
                      await launchUrl(uri);
                    } catch (e) {
                      if (context.mounted) {
                        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
                            content:
                                Text('Could not launch phone dialer: $e')));
                      }
                    }
                  },
                  icon: const Icon(Icons.call),
                  label: const Text('Call Student'),
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Row(
            children: [
              Expanded(
                child: OutlinedButton.icon(
                  style: OutlinedButton.styleFrom(
                      padding: const EdgeInsets.symmetric(vertical: 16)),
                  onPressed: () async {
                    await showDialog(
                      context: context,
                      builder: (ctx) => _EditStudentDialog(
                          student: student, branchId: branchId),
                    );
                  },
                  icon: const Icon(Icons.edit),
                  label: const Text('Edit Profile'),
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Row(
            children: [
              Expanded(
                child: OutlinedButton.icon(
                  style: OutlinedButton.styleFrom(
                      foregroundColor: Colors.red,
                      padding: const EdgeInsets.symmetric(vertical: 16)),
                  onPressed: () async {
                    final confirm = await showDialog<bool>(
                      context: context,
                      builder: (ctx) => AlertDialog(
                        title: const Text('Delete Student Profile?'),
                        content: Text(
                            'Are you sure you want to permanently delete ${student.name}?'),
                        actions: [
                          TextButton(
                              onPressed: () => Navigator.pop(ctx, false),
                              child: const Text('Cancel')),
                          FilledButton(
                            style: FilledButton.styleFrom(
                                backgroundColor: Colors.red),
                            onPressed: () => Navigator.pop(ctx, true),
                            child: const Text('Delete'),
                          ),
                        ],
                      ),
                    );
                    if (confirm == true && context.mounted) {
                      await repo.deleteStudentProfile(student.id);
                      if (context.mounted) Navigator.pop(context);
                    }
                  },
                  icon: const Icon(Icons.delete),
                  label: const Text('Delete Profile'),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _InfoRow extends StatelessWidget {
  const _InfoRow({required this.label, required this.value});
  final String label;
  final String value;
  @override
  Widget build(BuildContext context) => Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(label, style: const TextStyle(color: Colors.grey, fontSize: 15)),
          Text(value,
              style:
                  const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
        ],
      );
}

class _EditStudentDialog extends StatefulWidget {
  const _EditStudentDialog({required this.student, required this.branchId});
  final Student student;
  final String branchId;
  @override
  State<_EditStudentDialog> createState() => _EditStudentDialogState();
}

class _EditStudentDialogState extends State<_EditStudentDialog> {
  late TextEditingController _name;
  late TextEditingController _admission;
  late TextEditingController _mobile;
  late TextEditingController _photoUrl;
  late String _className;
  late String _medium;
  bool _busy = false;

  @override
  void initState() {
    super.initState();
    _name = TextEditingController(text: widget.student.name);
    _admission = TextEditingController(text: widget.student.admissionNumber);
    _mobile = TextEditingController(text: widget.student.mobile);
    _photoUrl = TextEditingController(text: widget.student.photoUrl);
    _className = widget.student.className;
    _medium = widget.student.medium;
  }

  @override
  void dispose() {
    _name.dispose();
    _admission.dispose();
    _mobile.dispose();
    _photoUrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final repo = context.read<FirestoreRepository>();
    return StreamBuilder<List<ClassModel>>(
      stream: repo.watchClassesForBranch(widget.branchId),
      builder: (context, classSnap) {
        final classes = classSnap.data ?? [];

        // Safe search for the current selection in the classes list.
        // If not found, we build a temporary ClassModel so DropdownButtonFormField doesn't throw an error.
        final ClassModel initialClass = classes.firstWhere(
          (c) => c.className == _className && c.medium == _medium,
          orElse: () => ClassModel(
            id: '',
            className: _className,
            medium: _medium,
            whatsappLink: '',
            institutionId: '',
            branchId: widget.branchId,
            colorValue: 0,
          ),
        );

        return AlertDialog(
          title: const Text('Edit Student Profile'),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                TextField(
                    controller: _name,
                    decoration: const InputDecoration(labelText: 'Full Name')),
                const SizedBox(height: 12),
                TextField(
                    controller: _admission,
                    decoration:
                        const InputDecoration(labelText: 'Admission No')),
                const SizedBox(height: 12),
                TextField(
                    controller: _mobile,
                    decoration: const InputDecoration(labelText: 'Mobile No')),
                const SizedBox(height: 12),
                TextField(
                    controller: _photoUrl,
                    decoration: const InputDecoration(labelText: 'Photo URL')),
                const SizedBox(height: 16),
                if (classSnap.connectionState == ConnectionState.waiting)
                  const CircularProgressIndicator()
                else if (classes.isEmpty)
                  Container(
                    padding: const EdgeInsets.all(12),
                    decoration: BoxDecoration(
                      color: Colors.amber.shade50,
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: const Text(
                      'No classes found for this branch. Create a class on the dashboard first.',
                      style: TextStyle(color: Colors.brown, fontSize: 13),
                    ),
                  )
                else
                  DropdownButtonFormField<ClassModel>(
                    decoration: const InputDecoration(
                      labelText: 'Assign Class',
                      border: OutlineInputBorder(),
                    ),
                    initialValue: initialClass,
                    items: classes.map((c) {
                      return DropdownMenuItem<ClassModel>(
                        value: c,
                        child: Text('${c.className} (${c.medium})'),
                      );
                    }).toList(),
                    onChanged: (val) {
                      if (val != null) {
                        setState(() {
                          _className = val.className;
                          _medium = val.medium;
                        });
                      }
                    },
                  ),
              ],
            ),
          ),
          actions: [
            TextButton(
                onPressed: _busy ? null : () => Navigator.pop(context),
                child: const Text('Cancel')),
            FilledButton(
              onPressed: _busy
                  ? null
                  : () async {
                      setState(() => _busy = true);
                      try {
                        await repo.updateStudentProfile(
                          uid: widget.student.id,
                          name: _name.text.trim(),
                          admissionNumber: _admission.text.trim(),
                          mobile: _mobile.text.trim(),
                          className: _className,
                          medium: _medium,
                          branchId: widget.branchId,
                          photoUrl: _photoUrl.text.trim(),
                        );
                        if (context.mounted) {
                          Navigator.pop(context);
                          Navigator.pop(context); // close detail screen
                        }
                      } catch (e) {
                        if (context.mounted) {
                          ScaffoldMessenger.of(context).showSnackBar(
                              SnackBar(content: Text('Error: $e')));
                        }
                      } finally {
                        if (mounted) setState(() => _busy = false);
                      }
                    },
              child: _busy
                  ? const CircularProgressIndicator()
                  : const Text('Save'),
            ),
          ],
        );
      },
    );
  }
}

// ==========================================
// 2. ATTENDANCE TAB
// ==========================================
class _AttendanceTab extends StatefulWidget {
  const _AttendanceTab({
    required this.className,
    required this.medium,
    required this.branchId,
    required this.whatsappLink,
    required this.classId,
    required this.attendanceMode,
  });
  final String className;
  final String medium;
  final String branchId;
  final String whatsappLink;
  final String classId;
  final AttendanceMode attendanceMode;

  @override
  State<_AttendanceTab> createState() => _AttendanceTabState();
}

class _AttendanceTabState extends State<_AttendanceTab> {
  DateTime _day = DateTime.now();
  bool _busy = false;
  AttendanceSession _selectedSession = AttendanceSession.daily;
  ClassAttendanceSession? _fnSessionStatus;
  ClassAttendanceSession? _anSessionStatus;

  DateTime get _dayUtc => DateTime.utc(_day.year, _day.month, _day.day);

  Future<void> _pickDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: _day,
      firstDate: DateTime.now().subtract(const Duration(days: 365)),
      lastDate: DateTime.now(),
    );
    if (picked != null) {
      setState(() {
        _day = picked;
        _selectedSession = AttendanceSession.daily;
        _fnSessionStatus = null;
        _anSessionStatus = null;
      });
    }
  }

  Future<void> _loadSessionStatuses(FirestoreRepository repo) async {
    if (widget.attendanceMode != AttendanceMode.twoSession) return;
    final fnStatus = await repo.getClassAttendanceSession(
      classId: widget.classId,
      dayUtc: _dayUtc,
      session: AttendanceSession.fn,
    );
    final anStatus = await repo.getClassAttendanceSession(
      classId: widget.classId,
      dayUtc: _dayUtc,
      session: AttendanceSession.an,
    );
    if (mounted) {
      setState(() {
        _fnSessionStatus = fnStatus;
        _anSessionStatus = anStatus;
      });
    }
  }

  Future<void> _setStatus(FirestoreRepository repo, Student student,
      AttendanceStatus status) async {
    await repo.upsertAttendance(
      studentId: student.id,
      branchId: widget.branchId,
      dayUtc: _dayUtc,
      session: _selectedSession,
      status: status,
    );
    // Update session status to completed when marking attendance
    if (widget.attendanceMode == AttendanceMode.twoSession) {
      await repo.setClassAttendanceSessionStatus(
        classId: widget.classId,
        branchId: widget.branchId,
        dayUtc: _dayUtc,
        session: _selectedSession,
        status: AttendanceSessionStatus.completed,
      );
      _loadSessionStatuses(repo);
    }
  }

  Future<void> _markAll(FirestoreRepository repo, List<Student> students,
      AttendanceStatus status) async {
    setState(() => _busy = true);
    try {
      await repo.bulkUpsertAttendanceWithSession(
        studentIds: students.map((s) => s.id).toList(),
        branchId: widget.branchId,
        dayUtc: _dayUtc,
        session: _selectedSession,
        status: status,
      );
      // Update session status to completed when marking attendance
      if (widget.attendanceMode == AttendanceMode.twoSession) {
        await repo.setClassAttendanceSessionStatus(
          classId: widget.classId,
          branchId: widget.branchId,
          dayUtc: _dayUtc,
          session: _selectedSession,
          status: AttendanceSessionStatus.completed,
        );
        _loadSessionStatuses(repo);
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _markSessionAsNoClass(FirestoreRepository repo) async {
    final sessionLabel = _selectedSession.label;
    final dateStr = DateFormat.yMMMMd().format(_dayUtc);
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Mark Session as No Class?'),
        content: Text(
            'Mark $sessionLabel attendance on $dateStr as No Class? This will apply to all students in ${widget.className} (${widget.medium}).'),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx, false),
              child: const Text('Cancel')),
          FilledButton(
            style: FilledButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('Mark as No Class'),
          ),
        ],
      ),
    );
    if (confirm != true) return;

    setState(() => _busy = true);
    try {
      await repo.markSessionAsNoClass(
        classId: widget.classId,
        branchId: widget.branchId,
        className: widget.className,
        medium: widget.medium,
        dayUtc: _dayUtc,
        session: _selectedSession,
      );
      _loadSessionStatuses(repo);
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('$sessionLabel marked as No Class')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _restoreSession(FirestoreRepository repo) async {
    final sessionLabel = _selectedSession.label;
    final dateStr = DateFormat.yMMMMd().format(_dayUtc);
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Restore Session?'),
        content: Text(
            'Restore $sessionLabel on $dateStr to allow attendance marking? This will change the status from No Class to Not Marked.'),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx, false),
              child: const Text('Cancel')),
          FilledButton(
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('Restore'),
          ),
        ],
      ),
    );
    if (confirm != true) return;

    setState(() => _busy = true);
    try {
      await repo.restoreSessionFromNoClass(
        classId: widget.classId,
        branchId: widget.branchId,
        dayUtc: _dayUtc,
        session: _selectedSession,
      );
      _loadSessionStatuses(repo);
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('$sessionLabel restored to Not Marked')),
        );
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Error: $e')));
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  void _sendAbsenteesToWhatsApp(
      List<Student> students, Map<String, AttendanceRecord> recordsMap) {
    final absentees = students
        .where((s) => recordsMap[s.id]?.status == AttendanceStatus.absent)
        .toList();
    final lateStudents = students
        .where((s) => recordsMap[s.id]?.status == AttendanceStatus.late)
        .toList();

    if (absentees.isEmpty && lateStudents.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
          content:
              Text('No absent or late students were marked on this date.')));
      return;
    }

    final groupUrl = widget.whatsappLink.trim();
    if (groupUrl.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
        content: Text(
            'WhatsApp group link for this class is not configured. Edit class details to add one.'),
      ));
      return;
    }

    final dateStr = DateFormat.yMMMMd().format(_dayUtc);
    final sessionLabel = _selectedSession.label;
    final buffer = StringBuffer();
    buffer.writeln('*Absentees & Late Students Report*');
    buffer.writeln('Date: $dateStr');
    buffer.writeln('Session: $sessionLabel');
    buffer.writeln('Class: ${widget.className} (${widget.medium})');
    buffer.writeln();

    if (absentees.isNotEmpty) {
      buffer.writeln('Absentees:');
      for (int i = 0; i < absentees.length; i++) {
        final s = absentees[i];
        buffer.writeln('${i + 1}. ${s.name} (Adm: ${s.admissionNumber})');
      }
      buffer.writeln();
    }

    if (lateStudents.isNotEmpty) {
      buffer.writeln('Late Students:');
      for (int i = 0; i < lateStudents.length; i++) {
        final s = lateStudents[i];
        buffer.writeln('${i + 1}. ${s.name} (Adm: ${s.admissionNumber})');
      }
      buffer.writeln();
    }

    final message = buffer.toString().trim();

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Send Absentees & Late Students'),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                  'The following message will be sent to the class WhatsApp group:'),
              const SizedBox(height: 12),
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                    color: Colors.grey.shade100,
                    borderRadius: BorderRadius.circular(8)),
                child: Text(message,
                    style:
                        const TextStyle(fontFamily: 'monospace', fontSize: 13)),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton.icon(
            style: FilledButton.styleFrom(backgroundColor: Colors.green),
            onPressed: () async {
              await Clipboard.setData(ClipboardData(text: message));
              if (ctx.mounted) {
                ScaffoldMessenger.of(ctx).showSnackBar(const SnackBar(
                    content: Text(
                        'Message copied to clipboard. Opening WhatsApp...')));
                Navigator.pop(ctx);
              }
              try {
                await launchUrl(Uri.parse(groupUrl),
                    mode: LaunchMode.externalApplication);
              } catch (e) {
                try {
                  final fallbackUri = Uri.parse(
                      'whatsapp://send?text=${Uri.encodeComponent(message)}');
                  await launchUrl(fallbackUri);
                } catch (_) {}
              }
            },
            icon: const Icon(Icons.send),
            label: const Text('Open Class Group & Send'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final repo = context.read<FirestoreRepository>();
    final dateLabel = DateFormat.yMMMEd().format(_dayUtc);
    final isTwoSession = widget.attendanceMode == AttendanceMode.twoSession;
    final sessionForQuery = isTwoSession ? _selectedSession : AttendanceSession.daily;

    // Load session statuses when date or session changes
    if (isTwoSession) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        _loadSessionStatuses(repo);
      });
    }

    return Column(
      children: [
        if (_busy) const LinearProgressIndicator(),
        Container(
          color: Theme.of(context)
              .colorScheme
              .primaryContainer
              .withValues(alpha: 0.3),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          child: Column(
            children: [
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  Text('Date: $dateLabel',
                      style: Theme.of(context)
                          .textTheme
                          .titleMedium
                          ?.copyWith(fontWeight: FontWeight.bold)),
                  OutlinedButton.icon(
                    onPressed: _pickDate,
                    icon: const Icon(Icons.calendar_month),
                    label: const Text('Change Date'),
                  ),
                ],
              ),
              if (isTwoSession) ...[
                const SizedBox(height: 12),
                _SessionSelector(
                  selectedSession: _selectedSession,
                  onSessionChanged: (session) {
                    setState(() {
                      _selectedSession = session;
                    });
                    _loadSessionStatuses(repo);
                  },
                  fnStatus: _fnSessionStatus,
                  anStatus: _anSessionStatus,
                ),
              ],
            ],
          ),
        ),
        Expanded(
          child: StreamBuilder<List<Student>>(
            stream: repo.watchStudentsForClass(
                branchId: widget.branchId,
                className: widget.className,
                medium: widget.medium),
            builder: (context, stuSnap) {
              if (stuSnap.hasError) {
                return Center(child: Text('Error: ${stuSnap.error}'));
              }
              if (!stuSnap.hasData) {
                return const Center(child: CircularProgressIndicator());
              }
              final students = stuSnap.data!;
              if (students.isEmpty) {
                return const Center(child: Text('No students in this class.'));
              }

              return StreamBuilder<List<AttendanceRecord>>(
                stream: isTwoSession
                    ? repo.watchAttendanceForBranchOnDateWithSession(
                        branchId: widget.branchId,
                        dayUtc: _dayUtc,
                        session: sessionForQuery,
                      )
                    : repo.watchAttendanceForBranchOnDate(
                        branchId: widget.branchId, dayUtc: _dayUtc),
                builder: (context, attSnap) {
                  final records = attSnap.data ?? [];
                  final byStudent = {for (final r in records) r.studentId: r};

                  // Determine session status for display
                  AttendanceSessionStatus? currentSessionStatus;
                  if (isTwoSession) {
                    if (_selectedSession == AttendanceSession.fn) {
                      currentSessionStatus = _fnSessionStatus?.status;
                    } else {
                      currentSessionStatus = _anSessionStatus?.status;
                    }
                  }

                  final isNoClass = currentSessionStatus == AttendanceSessionStatus.noClass;
                  final isCompleted = currentSessionStatus == AttendanceSessionStatus.completed;
                  final isNotMarked = currentSessionStatus == AttendanceSessionStatus.notMarked || currentSessionStatus == null;

                  return Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      if (isTwoSession) _SessionStatusSummary(
                        session: _selectedSession,
                        status: currentSessionStatus ?? AttendanceSessionStatus.notMarked,
                        presentCount: records.where((r) => r.status == AttendanceStatus.present).length,
                        absentCount: records.where((r) => r.status == AttendanceStatus.absent).length,
                        lateCount: records.where((r) => r.status == AttendanceStatus.late).length,
                      ),
                      Padding(
                        padding: const EdgeInsets.fromLTRB(16, 12, 16, 4),
                        child: FilledButton.icon(
                          style: FilledButton.styleFrom(
                              backgroundColor: Colors.teal.shade700,
                              padding:
                                  const EdgeInsets.symmetric(vertical: 12)),
                          onPressed: () =>
                              _sendAbsenteesToWhatsApp(students, byStudent),
                          icon: const Icon(Icons.share),
                          label: const Text(
                              'Send Absentees & Late to Class WhatsApp Group'),
                        ),
                      ),
                      Padding(
                        padding: const EdgeInsets.symmetric(
                            horizontal: 16, vertical: 8),
                        child: Row(
                          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                          children: [
                            FilledButton.icon(
                              style: FilledButton.styleFrom(
                                  backgroundColor: Colors.green),
                              onPressed: (isNoClass || _busy)
                                  ? null
                                  : () => _markAll(
                                      repo, students, AttendanceStatus.present),
                              icon: const Icon(Icons.check_circle_outline),
                              label: const Text('Mark All Present'),
                            ),
                            FilledButton.icon(
                              style: FilledButton.styleFrom(
                                  backgroundColor: Colors.red),
                              onPressed: (isNoClass || _busy)
                                  ? null
                                  : () => _markAll(
                                      repo, students, AttendanceStatus.absent),
                              icon: const Icon(Icons.cancel_outlined),
                              label: const Text('Mark All Absent'),
                            ),
                          ],
                        ),
                      ),
                      if (isTwoSession) ...[
                        const Divider(),
                        Padding(
                          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                          child: _NoClassActionButton(
                            session: _selectedSession,
                            isNoClass: isNoClass,
                            onMarkNoClass: isNoClass ? null : () => _markSessionAsNoClass(repo),
                            onRestore: isNoClass ? () => _restoreSession(repo) : null,
                          ),
                        ),
                      ],
                      const Divider(),
                      Expanded(
                        child: ListView.separated(
                          padding: const EdgeInsets.all(12),
                          itemCount: students.length,
                          separatorBuilder: (_, __) =>
                              const SizedBox(height: 10),
                          itemBuilder: (context, i) {
                            final s = students[i];
                            final current = byStudent[s.id]?.status;
                            return Card(
                              child: Padding(
                                padding: const EdgeInsets.all(16),
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Row(
                                      children: [
                                        CircleAvatar(
                                          backgroundImage: s.photoUrl.isNotEmpty
                                              ? NetworkImage(s.photoUrl)
                                              : null,
                                          child: s.photoUrl.isEmpty
                                              ? const Icon(Icons.person)
                                              : null,
                                        ),
                                        const SizedBox(width: 12),
                                        Expanded(
                                          child: Column(
                                            crossAxisAlignment:
                                                CrossAxisAlignment.start,
                                            children: [
                                              Text(s.name,
                                                  style: Theme.of(context)
                                                      .textTheme
                                                      .titleMedium
                                                      ?.copyWith(
                                                          fontWeight:
                                                              FontWeight.bold)),
                                              Text(
                                                  'Admission: ${s.admissionNumber}',
                                                  style: Theme.of(context)
                                                      .textTheme
                                                      .bodySmall),
                                            ],
                                          ),
                                        ),
                                      ],
                                    ),
                                    const SizedBox(height: 16),
                                    if (isNoClass) ...[
                                      Container(
                                        width: double.infinity,
                                        padding: const EdgeInsets.symmetric(vertical: 12),
                                        decoration: BoxDecoration(
                                          color: Colors.grey.shade100,
                                          borderRadius: BorderRadius.circular(8),
                                        ),
                                        child: Text(
                                          'No Class',
                                          textAlign: TextAlign.center,
                                          style: TextStyle(
                                            fontSize: 16,
                                            fontWeight: FontWeight.bold,
                                            color: Colors.grey.shade700,
                                          ),
                                        ),
                                      ),
                                    ] else ...[
                                      Row(
                                        children: [
                                          _StatusButton(
                                            label: 'Present',
                                            icon: Icons.check,
                                            color: Colors.green,
                                            selected: current ==
                                                AttendanceStatus.present,
                                            onTap: () => _setStatus(repo, s,
                                                AttendanceStatus.present),
                                          ),
                                          const SizedBox(width: 8),
                                          _StatusButton(
                                            label: 'Late',
                                            icon: Icons.access_time,
                                            color: Colors.orange,
                                            selected:
                                                current == AttendanceStatus.late,
                                            onTap: () => _setStatus(
                                                repo, s, AttendanceStatus.late),
                                          ),
                                          const SizedBox(width: 8),
                                          _StatusButton(
                                            label: 'Absent',
                                            icon: Icons.close,
                                            color: Colors.red,
                                            selected: current ==
                                                AttendanceStatus.absent,
                                            onTap: () => _setStatus(
                                                repo, s, AttendanceStatus.absent),
                                          ),
                                        ],
                                      ),
                                    ],
                                  ],
                                ),
                              ),
                            );
                          },
                        ),
                      ),
                    ],
                  );
                },
              );
            },
          ),
        ),
      ],
    );
  }
}

class _StatusButton extends StatelessWidget {
  const _StatusButton({
    required this.label,
    required this.icon,
    required this.color,
    required this.selected,
    required this.onTap,
  });

  final String label;
  final IconData icon;
  final Color color;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Expanded(
      child: Material(
        color: selected ? color : color.withValues(alpha: 0.1),
        borderRadius: BorderRadius.circular(8),
        child: InkWell(
          onTap: onTap,
          borderRadius: BorderRadius.circular(8),
          child: Container(
            padding: const EdgeInsets.symmetric(vertical: 10),
            child: Column(
              children: [
                Icon(icon, color: selected ? Colors.white : color, size: 20),
                const SizedBox(height: 2),
                Text(
                  label,
                  style: TextStyle(
                    fontSize: 13,
                    color: selected ? Colors.white : color,
                    fontWeight: selected ? FontWeight.bold : FontWeight.normal,
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

// ==========================================
// 3. MONTHLY REPORT TAB
// ==========================================
class _MonthlyTab extends StatefulWidget {
  const _MonthlyTab(
      {required this.className, required this.medium, required this.branchId});
  final String className;
  final String medium;
  final String branchId;
  @override
  State<_MonthlyTab> createState() => _MonthlyTabState();
}

class _MonthlyTabState extends State<_MonthlyTab> {
  late int _year;
  late int _month;

  @override
  void initState() {
    super.initState();
    final now = DateTime.now();
    _year = now.year;
    _month = now.month;
  }

  void _prevMonth() => setState(() {
        if (_month == 1) {
          _month = 12;
          _year--;
        } else {
          _month--;
        }
      });

  void _nextMonth() {
    final now = DateTime.now();
    if (_year > now.year || (_year == now.year && _month >= now.month)) return;
    setState(() {
      if (_month == 12) {
        _month = 1;
        _year++;
      } else {
        _month++;
      }
    });
  }

  String get _monthLabel => DateFormat.yMMMM().format(DateTime(_year, _month));
  int get _daysInMonth => DateTime(_year, _month + 1, 0).day;

  Future<void> _generateMonthlyReportPdf(
    List<Student> students,
    Map<String, Map<int, AttendanceStatus>> attendanceMap,
  ) async {
    final pdf = pw.Document();
    final monthName = DateFormat.yMMMM().format(DateTime(_year, _month));
    final todayLabel = DateFormat.yMMMMd().format(DateTime.now());
    final days = List.generate(_daysInMonth, (index) => index + 1);

    int totalPresent = 0;
    int totalAbsent = 0;
    int totalLate = 0;

    final rows = students.map((student) {
      final dayMap = attendanceMap[student.id] ?? {};
      final row = <String>[student.name];
      int pCount = 0;
      int aCount = 0;
      int lCount = 0;

      for (final day in days) {
        final status = dayMap[day];
        if (status == AttendanceStatus.present) {
          row.add('P');
          pCount++;
        } else if (status == AttendanceStatus.absent) {
          row.add('A');
          aCount++;
        } else if (status == AttendanceStatus.late) {
          row.add('L');
          lCount++;
        } else {
          row.add('-');
        }
      }

      totalPresent += pCount;
      totalAbsent += aCount;
      totalLate += lCount;
      row.addAll(['$pCount', '$aCount', '$lCount']);
      return row;
    }).toList();

    final header = <String>[
      'Student Name',
      ...days.map((d) => '$d'),
      'P',
      'A',
      'L',
    ];

    const int rowsPerPage = 25;
    final totalPages = rows.isEmpty ? 1 : (rows.length / rowsPerPage).ceil();

    for (int pageIndex = 0; pageIndex < totalPages; pageIndex++) {
      final start = pageIndex * rowsPerPage;
      final end = (start + rowsPerPage < rows.length)
          ? start + rowsPerPage
          : rows.length;
      final pageRows = rows.isEmpty ? <List<String>>[] : rows.sublist(start, end);

      pdf.addPage(pw.Page(
        pageFormat: PdfPageFormat.a4.landscape,
        margin: const pw.EdgeInsets.all(12),
        build: (context) => pw.Column(
          crossAxisAlignment: pw.CrossAxisAlignment.stretch,
          children: [
            pw.Text('Monthly Attendance Report',
                style:
                    pw.TextStyle(fontSize: 16, fontWeight: pw.FontWeight.bold)),
            pw.SizedBox(height: 6),
            pw.Row(
              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                pw.Column(
                  crossAxisAlignment: pw.CrossAxisAlignment.start,
                  children: [
                    pw.Text('Class: ${widget.className} ${widget.medium}',
                        style: pw.TextStyle(fontSize: 10)),
                    pw.Text('Month: $monthName',
                        style: pw.TextStyle(fontSize: 10)),
                  ],
                ),
                pw.Text('Generated: $todayLabel',
                    style: pw.TextStyle(fontSize: 9, color: PdfColors.grey700)),
              ],
            ),
            pw.SizedBox(height: 10),
            pw.Container(
              padding: const pw.EdgeInsets.symmetric(horizontal: 8, vertical: 6),
              decoration: pw.BoxDecoration(
                color: PdfColors.grey100,
                border: pw.Border.all(color: PdfColors.grey400),
              ),
              child: pw.Text(
                'Summary: Present $totalPresent  |  Absent $totalAbsent  |  Late $totalLate',
                style: pw.TextStyle(fontSize: 9, fontWeight: pw.FontWeight.bold),
              ),
            ),
            pw.SizedBox(height: 8),
            pw.Expanded(
              child: pw.Table(
                border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.5),
                columnWidths: {
                  0: const pw.FixedColumnWidth(85),
                  for (var i = 1; i < header.length - 3; i++)
                    i: const pw.FixedColumnWidth(18),
                  header.length - 3: const pw.FixedColumnWidth(20),
                  header.length - 2: const pw.FixedColumnWidth(20),
                  header.length - 1: const pw.FixedColumnWidth(20),
                },
                children: [
                  pw.TableRow(
                    decoration: pw.BoxDecoration(color: PdfColors.grey300),
                    children: header.map((h) {
                      final isSummary = h == 'P' || h == 'A' || h == 'L';
                      return pw.Padding(
                        padding: const pw.EdgeInsets.symmetric(
                            horizontal: 3, vertical: 4),
                        child: pw.Text(
                          h,
                          textAlign:
                              isSummary ? pw.TextAlign.center : pw.TextAlign.left,
                          style: pw.TextStyle(
                            fontSize: isSummary ? 8 : 9,
                            fontWeight: pw.FontWeight.bold,
                          ),
                        ),
                      );
                    }).toList(),
                  ),
                  ...pageRows.map((row) {
                    return pw.TableRow(
                      children: [
                        pw.Padding(
                          padding: const pw.EdgeInsets.symmetric(
                              horizontal: 3, vertical: 3),
                          child: pw.Text(
                            row[0],
                            maxLines: 1,
                            overflow: pw.TextOverflow.clip,
                            style: pw.TextStyle(fontSize: 8),
                          ),
                        ),
                        ...row.sublist(1).map((cell) {
                          final isSummary = row.indexOf(cell) >= row.length - 3;
                          return pw.Padding(
                            padding: const pw.EdgeInsets.symmetric(
                                horizontal: 2, vertical: 3),
                            child: pw.Text(
                              cell,
                              textAlign: pw.TextAlign.center,
                              style: pw.TextStyle(
                                fontSize: isSummary ? 8 : 7,
                                fontWeight: isSummary
                                    ? pw.FontWeight.bold
                                    : pw.FontWeight.normal,
                              ),
                            ),
                          );
                        }),
                      ],
                    );
                  }),
                ],
              ),
            ),
            pw.SizedBox(height: 8),
            pw.Row(
              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                pw.Text(
                    'Legend: P = Present  |  A = Absent  |  L = Late  |  - = No Entry',
                    style: pw.TextStyle(fontSize: 8, color: PdfColors.grey700)),
                pw.Text('Page ${pageIndex + 1} of $totalPages',
                    style: pw.TextStyle(fontSize: 8, color: PdfColors.grey700)),
              ],
            ),
          ],
        ),
      ));
    }

    try {
      final tempDir = await getTemporaryDirectory();
      final safeClass =
          widget.className.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final safeMedium =
          widget.medium.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final file = File(
          '${tempDir.path}/attendance_report_${safeClass}_${safeMedium}_${_year}_$_month.pdf');
      final bytes = await pdf.save();
      await file.writeAsBytes(bytes, flush: true);

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Report generated successfully!')),
      );

      await OpenFilex.open(file.path);
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Failed to create report: $e')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    final repo = context.read<FirestoreRepository>();
    final colorScheme = Theme.of(context).colorScheme;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Container(
          color: colorScheme.primaryContainer.withValues(alpha: 0.3),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              IconButton(
                  icon: const Icon(Icons.chevron_left), onPressed: _prevMonth),
              Text(_monthLabel,
                  style: Theme.of(context)
                      .textTheme
                      .titleMedium
                      ?.copyWith(fontWeight: FontWeight.bold)),
              IconButton(
                  icon: const Icon(Icons.chevron_right), onPressed: _nextMonth),
            ],
          ),
        ),
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
          child: Wrap(
            spacing: 16,
            children: [
              _LegendDot(color: Colors.green.shade600, label: 'Present'),
              _LegendDot(color: Colors.red.shade400, label: 'Absent'),
              _LegendDot(color: Colors.orange.shade400, label: 'Late'),
            ],
          ),
        ),
        const Divider(height: 1),
        Expanded(
          child: StreamBuilder<List<Student>>(
            stream: repo.watchStudentsForClass(
                branchId: widget.branchId,
                className: widget.className,
                medium: widget.medium),
            builder: (context, stuSnap) {
              if (stuSnap.hasError) {
                return Center(child: Text('Error: ${stuSnap.error}'));
              }
              if (!stuSnap.hasData) {
                return const Center(child: CircularProgressIndicator());
              }
              final students = stuSnap.data!;
              if (students.isEmpty) {
                return const Center(child: Text('No students in this class.'));
              }

              return StreamBuilder<List<AttendanceRecord>>(
                stream: repo.watchAttendanceForBranchInMonth(
                    branchId: widget.branchId, year: _year, month: _month),
                builder: (context, attSnap) {
                  final records = attSnap.data ?? [];
                  final attMap = <String, Map<int, AttendanceStatus>>{};
                  for (final r in records) {
                    attMap.putIfAbsent(r.studentId, () => {})[r.date.day] =
                        r.status;
                  }

                  final days = List.generate(_daysInMonth, (i) => i + 1);

                  return Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      Padding(
                        padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
                        child: FilledButton.icon(
                          style: FilledButton.styleFrom(
                            backgroundColor: Colors.red.shade700,
                            padding: const EdgeInsets.symmetric(vertical: 12),
                          ),
                          onPressed: () => _generateMonthlyReportPdf(
                              students, attMap),
                          icon: const Icon(Icons.picture_as_pdf),
                          label: const Text('Monthly Report'),
                        ),
                      ),
                      const SizedBox(height: 10),
                      Expanded(
                        child: SingleChildScrollView(
                          scrollDirection: Axis.vertical,
                          child: SingleChildScrollView(
                            scrollDirection: Axis.horizontal,
                            child: DataTable(
                              headingRowHeight: 40,
                              dataRowMinHeight: 48,
                              dataRowMaxHeight: 48,
                              columnSpacing: 8,
                              horizontalMargin: 16,
                              columns: [
                                const DataColumn(
                                    label: Text('Name',
                                        style: TextStyle(
                                            fontWeight: FontWeight.bold))),
                                ...days.map(
                                  (d) => DataColumn(
                                    label: SizedBox(
                                      width: 26,
                                      child: Text('$d',
                                          textAlign: TextAlign.center,
                                          style: const TextStyle(
                                              fontSize: 12,
                                              fontWeight: FontWeight.bold)),
                                    ),
                                  ),
                                ),
                                const DataColumn(
                                    label: Text('P',
                                        style: TextStyle(
                                            fontWeight: FontWeight.bold,
                                            color: Colors.green))),
                                const DataColumn(
                                    label: Text('A',
                                        style: TextStyle(
                                            fontWeight: FontWeight.bold,
                                            color: Colors.red))),
                                const DataColumn(
                                    label: Text('L',
                                        style: TextStyle(
                                            fontWeight: FontWeight.bold,
                                            color: Colors.orange))),
                              ],
                              rows: students.map((s) {
                                final dayMap = attMap[s.id] ?? {};
                                int pCount = 0, aCount = 0, lCount = 0;
                                final cells = days.map((d) {
                                  final status = dayMap[d];
                                  Color? color;
                                  String symbol = '';
                                  if (status == AttendanceStatus.present) {
                                    color = Colors.green.shade600;
                                    symbol = 'P';
                                    pCount++;
                                  } else if (status ==
                                      AttendanceStatus.absent) {
                                    color = Colors.red.shade400;
                                    symbol = 'A';
                                    aCount++;
                                  } else if (status == AttendanceStatus.late) {
                                    color = Colors.orange.shade400;
                                    symbol = 'L';
                                    lCount++;
                                  }
                                  return DataCell(
                                    Container(
                                      width: 26,
                                      height: 32,
                                      alignment: Alignment.center,
                                      decoration: BoxDecoration(
                                        color: color?.withValues(alpha: 0.15),
                                        borderRadius: BorderRadius.circular(4),
                                      ),
                                      child: Text(
                                        symbol,
                                        style: TextStyle(
                                            fontSize: 12,
                                            fontWeight: FontWeight.bold,
                                            color:
                                                color ?? Colors.grey.shade400),
                                      ),
                                    ),
                                  );
                                }).toList();

                                return DataRow(
                                  cells: [
                                    DataCell(SizedBox(
                                      width: 140,
                                      child: Text(s.name,
                                          overflow: TextOverflow.ellipsis,
                                          style: const TextStyle(
                                              fontWeight: FontWeight.w600)),
                                    )),
                                    ...cells,
                                    DataCell(Text('$pCount',
                                        style: TextStyle(
                                            color: Colors.green.shade700,
                                            fontWeight: FontWeight.bold))),
                                    DataCell(Text('$aCount',
                                        style: TextStyle(
                                            color: Colors.red.shade600,
                                            fontWeight: FontWeight.bold))),
                                    DataCell(Text('$lCount',
                                        style: TextStyle(
                                            color: Colors.orange.shade700,
                                            fontWeight: FontWeight.bold))),
                                  ],
                                );
                              }).toList(),
                            ),
                          ),
                        ),
                      ),
                    ],
                  );
                },
              );
            },
          ),
        ),
      ],
    );
  }
}

class _LegendDot extends StatelessWidget {
  const _LegendDot({required this.color, required this.label});
  final Color color;
  final String label;

  @override
  Widget build(BuildContext context) {
    return Row(
      mainAxisSize: MainAxisSize.min,
      children: [
        Container(
            width: 12,
            height: 12,
            decoration: BoxDecoration(color: color, shape: BoxShape.circle)),
        const SizedBox(width: 6),
        Text(label,
            style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w500)),
      ],
    );
  }
}

// ==========================================
// 4. MARKS TAB
// ==========================================
class _MarksTab extends StatefulWidget {
  const _MarksTab({
    required this.className,
    required this.medium,
    required this.branchId,
    required this.institutionId,
  });

  final String className;
  final String medium;
  final String branchId;
  final String institutionId;

  @override
  State<_MarksTab> createState() => _MarksTabState();
}

class _MarksTabState extends State<_MarksTab> {
  String _selectedExam = 'Midterm Exam';
  final List<String> _subjects = ['ENGLISH', 'PHYSICS', 'CHEMISTRY', 'BIOLOGY', 'MATHS', 'GEOGRAPHY', 'HISTORY', 'HINDI', 'LANG 1', 'LANG 2', 'IT'];

  late FirestoreRepository _repo;
  Stream<List<Student>>? _studentStream;
  Stream<List<ClassExam>>? _examStream;
  Stream<List<MarkRecord>>? _markStream;
  String? _lastExamForStream;
  bool _defaultsEnsured = false;
  String _institutionName = 'NAME OF THE INSTITUTION';

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    _repo = context.read<FirestoreRepository>();
    _studentStream ??= _repo.watchStudentsForClass(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
    );
    _examStream ??= _repo.watchClassExams(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
    );
    if (!_defaultsEnsured) {
      _defaultsEnsured = true;
      _repo.ensureDefaultClassExamsIfEmpty(
        branchId: widget.branchId,
        className: widget.className,
        medium: widget.medium,
      );
      _loadInstitutionName();
    }
    _refreshMarkStream();
  }

  Future<void> _loadInstitutionName() async {
    final institution = await _repo.getInstitutionById(widget.institutionId);
    if (institution != null && mounted) {
      setState(() {
        _institutionName = institution.name;
      });
    }
  }

  ClassExam? _findSelectedExam(List<ClassExam> exams) {
    for (final exam in exams) {
      if (exam.name == _selectedExam) return exam;
    }
    return exams.isNotEmpty ? exams.first : null;
  }

  void _refreshMarkStream() {
    if (_lastExamForStream == _selectedExam) return;
    _lastExamForStream = _selectedExam;
    _markStream = _repo.watchMarksForClass(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
      examName: _selectedExam,
    );
  }

  void _addNewExamDialog() {
    final nameController = TextEditingController();
    final totalController = TextEditingController(text: '100');
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Add Custom Exam'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: nameController,
              autofocus: true,
              decoration: const InputDecoration(
                labelText: 'Exam Name',
                hintText: 'E.g. Weekly Test 1',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: totalController,
              keyboardType: const TextInputType.numberWithOptions(signed: false, decimal: false),
              decoration: const InputDecoration(
                labelText: 'Total Marks (max per subject)',
                hintText: 'E.g. 50 or 100',
                border: OutlineInputBorder(),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            onPressed: () async {
              final name = nameController.text.trim();
              final total = int.tryParse(totalController.text.trim());
              if (name.isEmpty) return;
              if (total == null || total <= 0) {
                ScaffoldMessenger.of(ctx).showSnackBar(
                  const SnackBar(content: Text('Please enter a valid total marks value.')),
                );
                return;
              }
              try {
                await _repo.addClassExam(
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  name: name,
                  totalMarks: total,
                );
                if (mounted) {
                  setState(() {
                    _selectedExam = name;
                    _lastExamForStream = null;
                    _refreshMarkStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Add'),
          ),
        ],
      ),
    );
  }

  void _editExamDialog(ClassExam exam) {
    final nameController = TextEditingController(text: exam.name);
    final totalController = TextEditingController(text: exam.totalMarks.toString());
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Edit Exam'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            TextField(
              controller: nameController,
              decoration: const InputDecoration(
                labelText: 'Exam Name',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            TextField(
              controller: totalController,
              keyboardType: const TextInputType.numberWithOptions(signed: false, decimal: false),
              decoration: const InputDecoration(
                labelText: 'Total Marks (max per subject)',
                border: OutlineInputBorder(),
              ),
            ),
          ],
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            onPressed: () async {
              final name = nameController.text.trim();
              final total = int.tryParse(totalController.text.trim());
              if (name.isEmpty) return;
              if (total == null || total <= 0) {
                ScaffoldMessenger.of(ctx).showSnackBar(
                  const SnackBar(content: Text('Please enter a valid total marks value.')),
                );
                return;
              }
              try {
                await _repo.updateClassExam(
                  examId: exam.id,
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  oldName: exam.name,
                  newName: name,
                  totalMarks: total,
                );
                if (mounted && _selectedExam == exam.name && name != exam.name) {
                  setState(() {
                    _selectedExam = name;
                    _lastExamForStream = null;
                    _refreshMarkStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Save'),
          ),
        ],
      ),
    );
  }

  void _deleteExamDialog(ClassExam exam) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Delete Exam?'),
        content: Text(
          'Delete "${exam.name}" and all marks entered for this exam? This cannot be undone.',
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            style: FilledButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () async {
              try {
                await _repo.deleteClassExam(
                  examId: exam.id,
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  examName: exam.name,
                );
                if (mounted) {
                  setState(() {
                    if (_selectedExam == exam.name) {
                      _selectedExam = 'Midterm Exam';
                      _lastExamForStream = null;
                    }
                    _refreshMarkStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Delete'),
          ),
        ],
      ),
    );
  }

  void _addNewSubjectDialog() {
    final controller = TextEditingController();
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Add Subject'),
        content: TextField(
          controller: controller,
          autofocus: true,
          decoration: const InputDecoration(
            labelText: 'Subject Name',
            hintText: 'E.g. Hindi, Physics, Computer',
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            onPressed: () {
              final val = controller.text.trim();
              if (val.isNotEmpty) {
                setState(() {
                  if (!_subjects.contains(val)) _subjects.add(val);
                });
                Navigator.pop(ctx);
              }
            },
            child: const Text('Add'),
          ),
        ],
      ),
    );
  }

  void _editMarksDialog(Student student, MarkRecord? currentRecord, int totalMarks) {
    // Capture repo before async boundary — fixes save bug
    final repo = _repo;
    final examName = _selectedExam;
    final subjects = List<String>.from(_subjects);

    final controllers = {
      for (final sub in subjects)
        sub: TextEditingController(
          text: currentRecord?.subjectMarks[sub]?.toString() ?? '',
        )
    };

    showDialog(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx, setDialogState) => AlertDialog(
          title: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(student.name, style: const TextStyle(fontWeight: FontWeight.bold)),
              const SizedBox(height: 4),
              Text('Exam: $examName (max $totalMarks marks per subject)',
                  style: const TextStyle(fontSize: 14, fontWeight: FontWeight.normal, color: Colors.grey)),
            ],
          ),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                ...subjects.map((sub) => Padding(
                  padding: const EdgeInsets.only(bottom: 12),
                  child: TextField(
                    controller: controllers[sub],
                    keyboardType: const TextInputType.numberWithOptions(signed: false, decimal: false),
                    decoration: InputDecoration(
                      labelText: sub,
                      hintText: '0–$totalMarks',
                      border: const OutlineInputBorder(),
                      suffixText: 'marks',
                    ),
                  ),
                )),
              ],
            ),
          ),
          actions: [
            TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
            FilledButton(
              onPressed: () async {
                final marks = <String, int>{};
                for (final sub in subjects) {
                  final text = controllers[sub]?.text.trim() ?? '';
                  if (text.isNotEmpty) {
                    final parsed = int.tryParse(text);
                    if (parsed == null) {
                      ScaffoldMessenger.of(ctx).showSnackBar(
                        SnackBar(content: Text('Invalid marks for $sub.'), backgroundColor: Colors.red),
                      );
                      return;
                    }
                    if (parsed < 0 || parsed > totalMarks) {
                      ScaffoldMessenger.of(ctx).showSnackBar(
                        SnackBar(
                          content: Text('$sub marks must be between 0 and $totalMarks.'),
                          backgroundColor: Colors.red,
                        ),
                      );
                      return;
                    }
                    marks[sub] = parsed;
                  }
                }
                if (marks.isEmpty) {
                  Navigator.pop(ctx);
                  return;
                }
                try {
                  await repo.upsertMarkRecord(
                    studentId: student.id,
                    branchId: widget.branchId,
                    className: widget.className,
                    medium: widget.medium,
                    examName: examName,
                    subjectMarks: marks,
                  );
                  if (ctx.mounted) Navigator.pop(ctx);
                } catch (e) {
                  if (ctx.mounted) {
                    ScaffoldMessenger.of(ctx).showSnackBar(
                      SnackBar(content: Text('Error saving marks: $e'), backgroundColor: Colors.red),
                    );
                  }
                }
              },
              child: const Text('Save Marks'),
            ),
          ],
        ),
      ),
    );
  }

  Future<void> _generateMarksPdf(List<Student> students, List<MarkRecord> marks) async {
    final pdf = pw.Document();
    final markMap = {for (final m in marks) m.studentId: m};
    final activeSubjects = _subjects;
    final monthName = _selectedExam;
    final todayLabel = DateFormat.yMMMMd().format(DateTime.now());

    final header = <String>['Student Name', ...activeSubjects, 'Total'];
    final rows = students.map((s) {
      final record = markMap[s.id];
      final row = <String>[s.name];
      int total = 0;
      for (final sub in activeSubjects) {
        final mark = record?.subjectMarks[sub];
        if (mark != null) total += mark;
        row.add(mark?.toString() ?? '-');
      }
      row.add('$total');
      return row;
    }).toList();

    const int rowsPerPage = 25;
    final totalPages = rows.isEmpty ? 1 : (rows.length / rowsPerPage).ceil();

    for (int pageIndex = 0; pageIndex < totalPages; pageIndex++) {
      final start = pageIndex * rowsPerPage;
      final end = (start + rowsPerPage < rows.length) ? start + rowsPerPage : rows.length;
      final pageRows = rows.isEmpty ? <List<String>>[] : rows.sublist(start, end);

      pdf.addPage(pw.Page(
        pageFormat: PdfPageFormat.a4.landscape,
        margin: const pw.EdgeInsets.all(12),
        build: (context) => pw.Column(
          crossAxisAlignment: pw.CrossAxisAlignment.stretch,
          children: [
            pw.Text('Marks Report — $monthName',
                style: pw.TextStyle(fontSize: 16, fontWeight: pw.FontWeight.bold)),
            pw.SizedBox(height: 4),
            pw.Row(
              mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
              children: [
                pw.Text('Class: ${widget.className} ${widget.medium}',
                    style: pw.TextStyle(fontSize: 10)),
                pw.Text('Generated: $todayLabel',
                    style: pw.TextStyle(fontSize: 9, color: PdfColors.grey700)),
              ],
            ),
            pw.SizedBox(height: 10),
            pw.Expanded(
              child: pw.Table(
                border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.5),
                columnWidths: {
                  0: const pw.FixedColumnWidth(90),
                  for (var i = 1; i < header.length - 1; i++) i: const pw.FixedColumnWidth(40),
                  header.length - 1: const pw.FixedColumnWidth(35),
                },
                children: [
                  pw.TableRow(
                    decoration: pw.BoxDecoration(color: PdfColors.blue50),
                    children: header.map((h) => pw.Padding(
                      padding: const pw.EdgeInsets.symmetric(horizontal: 3, vertical: 4),
                      child: pw.Text(h,
                          textAlign: pw.TextAlign.center,
                          style: pw.TextStyle(fontSize: 8, fontWeight: pw.FontWeight.bold)),
                    )).toList(),
                  ),
                  ...pageRows.map((row) => pw.TableRow(
                    children: row.asMap().entries.map((entry) => pw.Padding(
                      padding: const pw.EdgeInsets.symmetric(horizontal: 3, vertical: 3),
                      child: pw.Text(entry.value,
                          textAlign: entry.key == 0 ? pw.TextAlign.left : pw.TextAlign.center,
                          style: pw.TextStyle(fontSize: 8, fontWeight: entry.key == row.length - 1 ? pw.FontWeight.bold : pw.FontWeight.normal)),
                    )).toList(),
                  )),
                ],
              ),
            ),
            pw.SizedBox(height: 4),
            pw.Text('Page ${pageIndex + 1} of $totalPages',
                textAlign: pw.TextAlign.right,
                style: pw.TextStyle(fontSize: 8, color: PdfColors.grey700)),
          ],
        ),
      ));
    }

    try {
      final tempDir = await getTemporaryDirectory();
      final safeClass = widget.className.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final safeExam = _selectedExam.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final file = File('${tempDir.path}/marks_${safeClass}_$safeExam.pdf');
      await file.writeAsBytes(await pdf.save(), flush: true);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Marks PDF generated!')),
      );
      await OpenFilex.open(file.path);
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
      );
    }
  }

  void _sendMarksToWhatsApp(Student student, MarkRecord record, int totalMarks) {
    final message = buildMarksWhatsAppMessage(
      examName: _selectedExam,
      studentName: student.name,
      className: widget.className,
      division: widget.medium,
      branchName: widget.branchId,
      admissionNumber: student.admissionNumber,
      institutionName: _institutionName,
      subjectMarks: record.subjectMarks,
      totalMarksPerSubject: totalMarks,
    );

    openWhatsAppMessage(student.mobile, message);
  }

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;

    return StreamBuilder<List<ClassExam>>(
      stream: _examStream,
      builder: (context, examSnap) {
        if (examSnap.hasError) {
          return Center(child: Text('Error loading exams: ${examSnap.error}'));
        }
        if (!examSnap.hasData) {
          return const Center(child: CircularProgressIndicator());
        }

        final exams = examSnap.data!;
        if (exams.isNotEmpty && !exams.any((e) => e.name == _selectedExam)) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) {
              setState(() {
                _selectedExam = exams.first.name;
                _lastExamForStream = null;
                _refreshMarkStream();
              });
            }
          });
        }

        final selectedExam = _findSelectedExam(exams);
        final totalMarks = selectedExam?.totalMarks ?? 100;
        final examNames = exams.map((e) => e.name).toList();

        return Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Container(
              color: colorScheme.primaryContainer.withValues(alpha: 0.3),
              padding: const EdgeInsets.fromLTRB(12, 6, 12, 6),
              child: Row(
                children: [
                  const Text('Exam:', style: TextStyle(fontWeight: FontWeight.bold)),
                  const SizedBox(width: 8),
                  Expanded(
                    child: DropdownButton<String>(
                      value: examNames.contains(_selectedExam) ? _selectedExam : null,
                      hint: Text(_selectedExam),
                      isExpanded: true,
                      underline: const SizedBox.shrink(),
                      items: examNames
                          .map((e) => DropdownMenuItem(
                                value: e,
                                child: Text(
                                  exams.firstWhere((x) => x.name == e).totalMarks == 100
                                      ? e
                                      : '$e (${exams.firstWhere((x) => x.name == e).totalMarks} marks)',
                                  overflow: TextOverflow.ellipsis,
                                ),
                              ))
                          .toList(),
                      onChanged: (val) {
                        if (val != null && val != _selectedExam) {
                          setState(() {
                            _selectedExam = val;
                            _lastExamForStream = null;
                            _refreshMarkStream();
                          });
                        }
                      },
                    ),
                  ),
                  if (selectedExam != null) ...[
                    IconButton.filledTonal(
                      icon: const Icon(Icons.edit, size: 18),
                      tooltip: 'Edit Exam',
                      onPressed: () => _editExamDialog(selectedExam),
                    ),
                    IconButton.filledTonal(
                      icon: const Icon(Icons.delete_outline, size: 18),
                      tooltip: 'Delete Exam',
                      onPressed: () => _deleteExamDialog(selectedExam),
                    ),
                  ],
                  IconButton.filledTonal(
                    icon: const Icon(Icons.post_add, size: 18),
                    tooltip: 'Add Exam',
                    onPressed: _addNewExamDialog,
                  ),
                  IconButton.filledTonal(
                    icon: const Icon(Icons.subject, size: 18),
                    tooltip: 'Add Subject',
                    onPressed: _addNewSubjectDialog,
                  ),
                ],
              ),
            ),
            const Divider(height: 1),
            Expanded(
              child: StreamBuilder<List<Student>>(
                stream: _studentStream,
                builder: (context, stuSnap) {
                  if (stuSnap.hasError) return Center(child: Text('Error: ${stuSnap.error}'));
                  if (!stuSnap.hasData) return const Center(child: CircularProgressIndicator());
                  final students = stuSnap.data!;
                  if (students.isEmpty) return const Center(child: Text('No students in this class.'));

                  return StreamBuilder<List<MarkRecord>>(
                    stream: _markStream,
                    builder: (context, markSnap) {
                      final marks = markSnap.data ?? [];
                      final markMap = {for (final m in marks) m.studentId: m};

                      return Column(
                        children: [
                          Padding(
                            padding: const EdgeInsets.fromLTRB(12, 10, 12, 0),
                            child: FilledButton.icon(
                              style: FilledButton.styleFrom(
                                backgroundColor: Colors.deepPurple,
                                minimumSize: const Size(double.infinity, 44),
                              ),
                              onPressed: marks.isEmpty && students.isNotEmpty
                                  ? null
                                  : () => _generateMarksPdf(students, marks),
                              icon: const Icon(Icons.picture_as_pdf),
                              label: Text('Marks Report PDF — $_selectedExam'),
                            ),
                          ),
                          const SizedBox(height: 6),
                          Expanded(
                            child: ListView.separated(
                              padding: const EdgeInsets.fromLTRB(12, 4, 12, 12),
                              itemCount: students.length,
                              separatorBuilder: (_, __) => const SizedBox(height: 8),
                              itemBuilder: (context, i) {
                                final s = students[i];
                                final record = markMap[s.id];
                                final total = record?.subjectMarks.values.fold(0, (a, b) => a + b) ?? 0;
                                final enteredCount = record?.subjectMarks.length ?? 0;

                                return Card(
                                  margin: EdgeInsets.zero,
                                  child: ListTile(
                                    contentPadding: const EdgeInsets.fromLTRB(12, 6, 8, 6),
                                    leading: CircleAvatar(
                                      backgroundColor: colorScheme.secondaryContainer,
                                      child: Text(
                                        s.name.isNotEmpty ? s.name[0].toUpperCase() : '?',
                                        style: TextStyle(color: colorScheme.onSecondaryContainer),
                                      ),
                                    ),
                                    title: Text(s.name, style: const TextStyle(fontWeight: FontWeight.bold)),
                                    subtitle: enteredCount == 0
                                        ? Text('No marks entered yet (max $totalMarks per subject)',
                                            style: const TextStyle(fontStyle: FontStyle.italic))
                                        : Column(
                                            crossAxisAlignment: CrossAxisAlignment.start,
                                            children: [
                                              Text(
                                                _subjects.map((sub) {
                                                  final mark = record?.subjectMarks[sub];
                                                  return '$sub: ${mark ?? "-"}';
                                                }).join('  •  '),
                                                style: const TextStyle(fontSize: 12),
                                              ),
                                              Text('Total: $total',
                                                  style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13)),
                                            ],
                                          ),
                                    isThreeLine: enteredCount > 0,
                                    trailing: Row(
                                      mainAxisSize: MainAxisSize.min,
                                      children: [
                                        if (record != null)
                                          IconButton.filledTonal(
                                            onPressed: () => _sendMarksToWhatsApp(s, record, totalMarks),
                                            icon: const Icon(Icons.message, size: 18),
                                            tooltip: 'Send WhatsApp',
                                            style: IconButton.styleFrom(backgroundColor: Colors.green),
                                          ),
                                        const SizedBox(width: 4),
                                        FilledButton.icon(
                                          onPressed: selectedExam == null
                                              ? null
                                              : () => _editMarksDialog(s, record, totalMarks),
                                          icon: const Icon(Icons.edit, size: 16),
                                          label: const Text('Enter'),
                                        ),
                                      ],
                                    ),
                                  ),
                                );
                              },
                            ),
                          ),
                        ],
                      );
                    },
                  );
                },
              ),
            ),
          ],
        );
      },
    );
  }
}

// ==========================================
// 5. FEES TAB
// ==========================================
class _FeesTab extends StatefulWidget {
  const _FeesTab({
    required this.className,
    required this.medium,
    required this.branchId,
    required this.institutionId,
  });

  final String className;
  final String medium;
  final String branchId;
  final String institutionId;

  @override
  State<_FeesTab> createState() => _FeesTabState();
}

class _FeesTabState extends State<_FeesTab> {
  String _selectedFeeCategory = 'Tuition Fee - Term 1';

  late FirestoreRepository _repo;
  Stream<List<Student>>? _studentStream;
  Stream<List<ClassFeeCategory>>? _categoryStream;
  Stream<List<FeeRecord>>? _feeStream;
  String? _lastCategoryForStream;
  bool _defaultsEnsured = false;
  String _institutionName = 'NAME OF THE INSTITUTION';

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    _repo = context.read<FirestoreRepository>();
    _studentStream ??= _repo.watchStudentsForClass(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
    );
    _categoryStream ??= _repo.watchClassFeeCategories(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
    );
    if (!_defaultsEnsured) {
      _defaultsEnsured = true;
      _repo.ensureDefaultClassFeeCategoriesIfEmpty(
        branchId: widget.branchId,
        className: widget.className,
        medium: widget.medium,
      );
      _loadInstitutionName();
    }
    _refreshFeeStream();
  }

  Future<void> _loadInstitutionName() async {
    final institution = await _repo.getInstitutionById(widget.institutionId);
    if (institution != null && mounted) {
      setState(() {
        _institutionName = institution.name;
      });
    }
  }

  ClassFeeCategory? _findSelectedCategory(List<ClassFeeCategory> categories) {
    for (final cat in categories) {
      if (cat.name == _selectedFeeCategory) return cat;
    }
    return categories.isNotEmpty ? categories.first : null;
  }

  void _refreshFeeStream() {
    if (_lastCategoryForStream == _selectedFeeCategory) return;
    _lastCategoryForStream = _selectedFeeCategory;
    _feeStream = _repo.watchFeesForClass(
      branchId: widget.branchId,
      className: widget.className,
      medium: widget.medium,
      feeCategory: _selectedFeeCategory,
    );
  }

  void _addNewCategoryDialog() {
    final controller = TextEditingController();
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Add Custom Fee Category'),
        content: TextField(
          controller: controller,
          autofocus: true,
          decoration: const InputDecoration(
            labelText: 'Category Name',
            hintText: 'E.g. Bus Fee - July',
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            onPressed: () async {
              final val = controller.text.trim();
              if (val.isEmpty) return;
              try {
                await _repo.addClassFeeCategory(
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  name: val,
                );
                if (mounted) {
                  setState(() {
                    _selectedFeeCategory = val;
                    _lastCategoryForStream = null;
                    _refreshFeeStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Add'),
          ),
        ],
      ),
    );
  }

  void _editCategoryDialog(ClassFeeCategory category) {
    final controller = TextEditingController(text: category.name);
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Edit Fee Category'),
        content: TextField(
          controller: controller,
          decoration: const InputDecoration(
            labelText: 'Category Name',
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            onPressed: () async {
              final val = controller.text.trim();
              if (val.isEmpty) return;
              try {
                await _repo.updateClassFeeCategory(
                  categoryId: category.id,
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  oldName: category.name,
                  newName: val,
                );
                if (mounted && _selectedFeeCategory == category.name && val != category.name) {
                  setState(() {
                    _selectedFeeCategory = val;
                    _lastCategoryForStream = null;
                    _refreshFeeStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Save'),
          ),
        ],
      ),
    );
  }

  void _deleteCategoryDialog(ClassFeeCategory category) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Delete Fee Category?'),
        content: Text(
          'Delete "${category.name}" and all payment records for this category? This cannot be undone.',
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton(
            style: FilledButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () async {
              try {
                await _repo.deleteClassFeeCategory(
                  categoryId: category.id,
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  categoryName: category.name,
                );
                if (mounted) {
                  setState(() {
                    if (_selectedFeeCategory == category.name) {
                      _selectedFeeCategory = 'Tuition Fee - Term 1';
                      _lastCategoryForStream = null;
                    }
                    _refreshFeeStream();
                  });
                }
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            child: const Text('Delete'),
          ),
        ],
      ),
    );
  }

  void _recordPaymentDialog(Student student, FeeRecord? currentRecord) {
    // Capture repo before async boundary — fixes save bug
    final repo = _repo;
    final feeCategory = _selectedFeeCategory;

    final totalController = TextEditingController(
      text: currentRecord?.totalAmount == null
          ? ''
          : currentRecord!.totalAmount % 1 == 0
              ? currentRecord.totalAmount.toInt().toString()
              : currentRecord.totalAmount.toString(),
    );
    final amountController = TextEditingController();
    final receiptController = TextEditingController();

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(student.name, style: const TextStyle(fontWeight: FontWeight.bold)),
            const SizedBox(height: 4),
            Text('Category: $feeCategory',
                style: const TextStyle(fontSize: 13, fontWeight: FontWeight.normal, color: Colors.grey)),
          ],
        ),
        content: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              if (currentRecord != null)
                Container(
                  margin: const EdgeInsets.only(bottom: 12),
                  padding: const EdgeInsets.all(10),
                  decoration: BoxDecoration(
                    color: Colors.grey.shade100,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text('Total: ₹${currentRecord.totalAmount.toStringAsFixed(0)}'),
                      Text('Paid: ₹${currentRecord.amountPaid.toStringAsFixed(0)}'),
                      Text(
                        'Dues: ₹${(currentRecord.totalAmount - currentRecord.amountPaid).toStringAsFixed(0)}',
                        style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.red),
                      ),
                    ],
                  ),
                ),
              TextField(
                controller: totalController,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                enabled: currentRecord == null,
                decoration: const InputDecoration(
                  labelText: 'Total Fee Amount (₹)',
                  border: OutlineInputBorder(),
                  prefixText: '₹ ',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: amountController,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                autofocus: true,
                decoration: const InputDecoration(
                  labelText: 'Payment Amount Now (₹)',
                  hintText: 'Enter amount received',
                  border: OutlineInputBorder(),
                  prefixText: '₹ ',
                ),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: receiptController,
                decoration: const InputDecoration(
                  labelText: 'Receipt / Reference Number (optional)',
                  border: OutlineInputBorder(),
                ),
              ),
            ],
          ),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          FilledButton.icon(
            onPressed: () async {
              final total = double.tryParse(totalController.text.trim()) ?? 0.0;
              final amount = double.tryParse(amountController.text.trim()) ?? 0.0;
              final receipt = receiptController.text.trim();

              if (amount <= 0) {
                ScaffoldMessenger.of(ctx).showSnackBar(
                  const SnackBar(content: Text('Please enter a valid payment amount.')),
                );
                return;
              }
              if (currentRecord == null && total <= 0) {
                ScaffoldMessenger.of(ctx).showSnackBar(
                  const SnackBar(content: Text('Please enter the total fee amount.')),
                );
                return;
              }

              try {
                await repo.recordFeePayment(
                  studentId: student.id,
                  branchId: widget.branchId,
                  className: widget.className,
                  medium: widget.medium,
                  feeCategory: feeCategory,
                  totalAmount: currentRecord?.totalAmount ?? total,
                  paymentAmount: amount,
                  receiptNumber: receipt.isEmpty ? 'N/A' : receipt,
                  dueDate: DateTime.now().add(const Duration(days: 30)),
                );
                if (ctx.mounted) Navigator.pop(ctx);
              } catch (e) {
                if (ctx.mounted) {
                  ScaffoldMessenger.of(ctx).showSnackBar(
                    SnackBar(content: Text('Error saving payment: $e'), backgroundColor: Colors.red),
                  );
                }
              }
            },
            icon: const Icon(Icons.check),
            label: const Text('Record Payment'),
          ),
        ],
      ),
    );
  }

  void _showHistoryDialog(Student student, FeeRecord record) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          mainAxisSize: MainAxisSize.min,
          children: [
            Text('Payment History: ${student.name}'),
            const SizedBox(height: 4),
            Text('Category: ${record.feeCategory}',
                style: const TextStyle(fontSize: 13, fontWeight: FontWeight.normal, color: Colors.grey)),
          ],
        ),
        content: record.paymentHistory.isEmpty
            ? const Text('No payments recorded.')
            : SizedBox(
                width: double.maxFinite,
                child: ListView.builder(
                  shrinkWrap: true,
                  itemCount: record.paymentHistory.length,
                  itemBuilder: (context, i) {
                    final item = record.paymentHistory[i];
                    final dateStr = DateFormat.yMMMd().add_jm().format(item.date);
                    return ListTile(
                      leading: const Icon(Icons.receipt_long, color: Colors.green),
                      title: Text('₹${item.amount.toStringAsFixed(0)}',
                          style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
                      subtitle: Text('Receipt: ${item.receiptNumber}\n$dateStr'),
                      isThreeLine: true,
                    );
                  },
                ),
              ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Close')),
        ],
      ),
    );
  }

  Future<void> _generateFeesPdf(List<Student> students, List<FeeRecord> fees) async {
    final pdf = pw.Document();
    final feeMap = {for (final f in fees) f.studentId: f};
    final todayLabel = DateFormat.yMMMMd().format(DateTime.now());

    int totalPaid = 0;
    int totalPending = 0;
    final rows = students.map((s) {
      final f = feeMap[s.id];
      final total = f?.totalAmount.toInt() ?? 0;
      final paid = f?.amountPaid.toInt() ?? 0;
      final pending = total - paid;
      totalPaid += paid;
      totalPending += pending;
      return [s.name, total == 0 ? '-' : '₹$total', '₹$paid', '₹$pending', f?.status ?? 'Unpaid'];
    }).toList();

    const int rowsPerPage = 30;
    final totalPages = rows.isEmpty ? 1 : (rows.length / rowsPerPage).ceil();

    for (int pageIndex = 0; pageIndex < totalPages; pageIndex++) {
      final start = pageIndex * rowsPerPage;
      final end = (start + rowsPerPage < rows.length) ? start + rowsPerPage : rows.length;
      final pageRows = rows.isEmpty ? <List<String>>[] : rows.sublist(start, end);

      pdf.addPage(pw.Page(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(16),
        build: (context) => pw.Column(
          crossAxisAlignment: pw.CrossAxisAlignment.stretch,
          children: [
            pw.Text('Fee Report — $_selectedFeeCategory',
                style: pw.TextStyle(fontSize: 16, fontWeight: pw.FontWeight.bold)),
            pw.SizedBox(height: 4),
            pw.Row(mainAxisAlignment: pw.MainAxisAlignment.spaceBetween, children: [
              pw.Text('Class: ${widget.className} ${widget.medium}', style: pw.TextStyle(fontSize: 10)),
              pw.Text('Generated: $todayLabel', style: pw.TextStyle(fontSize: 9, color: PdfColors.grey700)),
            ]),
            pw.SizedBox(height: 8),
            pw.Container(
              padding: const pw.EdgeInsets.all(8),
              decoration: pw.BoxDecoration(color: PdfColors.grey100, border: pw.Border.all(color: PdfColors.grey400)),
              child: pw.Text(
                'Total Collected: ₹$totalPaid  |  Total Pending: ₹$totalPending',
                style: pw.TextStyle(fontSize: 9, fontWeight: pw.FontWeight.bold),
              ),
            ),
            pw.SizedBox(height: 8),
            pw.Expanded(
              child: pw.Table(
                border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.5),
                columnWidths: {
                  0: const pw.FixedColumnWidth(120),
                  1: const pw.FixedColumnWidth(60),
                  2: const pw.FixedColumnWidth(60),
                  3: const pw.FixedColumnWidth(60),
                  4: const pw.FixedColumnWidth(80),
                },
                children: [
                  pw.TableRow(
                    decoration: pw.BoxDecoration(color: PdfColors.green50),
                    children: ['Student Name', 'Total', 'Paid', 'Dues', 'Status'].map((h) => pw.Padding(
                      padding: const pw.EdgeInsets.symmetric(horizontal: 4, vertical: 4),
                      child: pw.Text(h, style: pw.TextStyle(fontSize: 9, fontWeight: pw.FontWeight.bold)),
                    )).toList(),
                  ),
                  ...pageRows.map((row) => pw.TableRow(
                    children: row.asMap().entries.map((e) => pw.Padding(
                      padding: const pw.EdgeInsets.symmetric(horizontal: 4, vertical: 3),
                      child: pw.Text(e.value, style: pw.TextStyle(fontSize: 8)),
                    )).toList(),
                  )),
                ],
              ),
            ),
            pw.SizedBox(height: 4),
            pw.Text('Page ${pageIndex + 1} of $totalPages',
                textAlign: pw.TextAlign.right,
                style: pw.TextStyle(fontSize: 8, color: PdfColors.grey700)),
          ],
        ),
      ));
    }

    try {
      final tempDir = await getTemporaryDirectory();
      final safeClass = widget.className.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final safeCat = _selectedFeeCategory.replaceAll(RegExp(r'[^A-Za-z0-9_]'), '_');
      final file = File('${tempDir.path}/fees_${safeClass}_$safeCat.pdf');
      await file.writeAsBytes(await pdf.save(), flush: true);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Fee Report PDF generated!')),
      );
      await OpenFilex.open(file.path);
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error: $e'), backgroundColor: Colors.red),
      );
    }
  }

  void _sendFeesToWhatsApp(Student student, FeeRecord record) {
    final pending = record.totalAmount - record.amountPaid;
    
    final message = buildFeeWhatsAppMessage(
      studentName: student.name,
      className: widget.className,
      division: widget.medium,
      branchName: widget.branchId,
      institutionName: _institutionName,
      totalFee: record.totalAmount,
      pendingFee: pending,
      lastDate: record.dueDate,
    );

    openWhatsAppMessage(student.mobile, message);
  }

  @override
  Widget build(BuildContext context) {
    final colorScheme = Theme.of(context).colorScheme;

    return StreamBuilder<List<ClassFeeCategory>>(
      stream: _categoryStream,
      builder: (context, catSnap) {
        if (catSnap.hasError) {
          return Center(child: Text('Error loading categories: ${catSnap.error}'));
        }
        if (!catSnap.hasData) {
          return const Center(child: CircularProgressIndicator());
        }

        final categories = catSnap.data!;
        if (categories.isNotEmpty && !categories.any((c) => c.name == _selectedFeeCategory)) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) {
              setState(() {
                _selectedFeeCategory = categories.first.name;
                _lastCategoryForStream = null;
                _refreshFeeStream();
              });
            }
          });
        }

        final selectedCategory = _findSelectedCategory(categories);
        final categoryNames = categories.map((c) => c.name).toList();

        return Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            Container(
              color: colorScheme.primaryContainer.withValues(alpha: 0.3),
              padding: const EdgeInsets.fromLTRB(12, 6, 12, 6),
              child: Row(
                children: [
                  const Text('Category:', style: TextStyle(fontWeight: FontWeight.bold)),
                  const SizedBox(width: 8),
                  Expanded(
                    child: DropdownButton<String>(
                      value: categoryNames.contains(_selectedFeeCategory) ? _selectedFeeCategory : null,
                      hint: Text(_selectedFeeCategory),
                      isExpanded: true,
                      underline: const SizedBox.shrink(),
                      items: categoryNames
                          .map((e) => DropdownMenuItem(
                                value: e,
                                child: Text(e, overflow: TextOverflow.ellipsis),
                              ))
                          .toList(),
                      onChanged: (val) {
                        if (val != null && val != _selectedFeeCategory) {
                          setState(() {
                            _selectedFeeCategory = val;
                            _lastCategoryForStream = null;
                            _refreshFeeStream();
                          });
                        }
                      },
                    ),
                  ),
                  if (selectedCategory != null) ...[
                    IconButton.filledTonal(
                      icon: const Icon(Icons.edit, size: 18),
                      tooltip: 'Edit Category',
                      onPressed: () => _editCategoryDialog(selectedCategory),
                    ),
                    IconButton.filledTonal(
                      icon: const Icon(Icons.delete_outline, size: 18),
                      tooltip: 'Delete Category',
                      onPressed: () => _deleteCategoryDialog(selectedCategory),
                    ),
                  ],
                  IconButton.filledTonal(
                    icon: const Icon(Icons.add, size: 18),
                    tooltip: 'Add Category',
                    onPressed: _addNewCategoryDialog,
                  ),
                ],
              ),
            ),
            const Divider(height: 1),
            Expanded(
              child: StreamBuilder<List<Student>>(
                stream: _studentStream,
                builder: (context, stuSnap) {
                  if (stuSnap.hasError) return Center(child: Text('Error: ${stuSnap.error}'));
                  if (!stuSnap.hasData) return const Center(child: CircularProgressIndicator());
                  final students = stuSnap.data!;
                  if (students.isEmpty) return const Center(child: Text('No students in this class.'));

                  return StreamBuilder<List<FeeRecord>>(
                    stream: _feeStream,
                    builder: (context, feeSnap) {
                      final fees = feeSnap.data ?? [];
                      final feeMap = {for (final f in fees) f.studentId: f};

                      int paid = 0, partial = 0, unpaid = 0;
                      for (final s in students) {
                        final status = feeMap[s.id]?.status ?? 'Unpaid';
                        if (status == 'Paid') {
                          paid++;
                        } else if (status == 'Partially Paid') {
                          partial++;
                        } else {
                          unpaid++;
                        }
                      }

                      return Column(
                        children: [
                          Padding(
                            padding: const EdgeInsets.fromLTRB(12, 10, 12, 4),
                            child: Column(
                              children: [
                                Row(
                                  mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                                  children: [
                                    _FeeChip(label: 'Paid', count: paid, color: Colors.green),
                                    _FeeChip(label: 'Partial', count: partial, color: Colors.orange),
                                    _FeeChip(label: 'Unpaid', count: unpaid, color: Colors.red),
                                  ],
                                ),
                                const SizedBox(height: 8),
                                FilledButton.icon(
                                  style: FilledButton.styleFrom(
                                    backgroundColor: Colors.teal.shade700,
                                    minimumSize: const Size(double.infinity, 44),
                                  ),
                                  onPressed: () => _generateFeesPdf(students, fees),
                                  icon: const Icon(Icons.picture_as_pdf),
                                  label: const Text('Fee Report PDF'),
                                ),
                              ],
                            ),
                          ),
                          const Divider(height: 1),
                          Expanded(
                            child: ListView.separated(
                              padding: const EdgeInsets.fromLTRB(12, 8, 12, 12),
                              itemCount: students.length,
                              separatorBuilder: (_, __) => const SizedBox(height: 8),
                              itemBuilder: (context, i) {
                                final s = students[i];
                                final record = feeMap[s.id];

                                final total = record?.totalAmount ?? 0.0;
                                final paidAmt = record?.amountPaid ?? 0.0;
                                final pending = total - paidAmt;
                                final status = record?.status ?? 'Unpaid';

                                Color badgeColor = Colors.red;
                                if (status == 'Paid') {
                                  badgeColor = Colors.green;
                                } else if (status == 'Partially Paid') {
                                  badgeColor = Colors.orange;
                                }

                                return Card(
                                  margin: EdgeInsets.zero,
                                  child: Padding(
                                    padding: const EdgeInsets.fromLTRB(12, 10, 12, 10),
                                    child: Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Row(
                                          children: [
                                            Expanded(
                                              child: Text(s.name,
                                                  style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
                                            ),
                                            Container(
                                              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                                              decoration: BoxDecoration(
                                                color: badgeColor.withValues(alpha: 0.12),
                                                borderRadius: BorderRadius.circular(4),
                                                border: Border.all(color: badgeColor),
                                              ),
                                              child: Text(status,
                                                  style: TextStyle(
                                                      color: badgeColor,
                                                      fontWeight: FontWeight.bold,
                                                      fontSize: 11)),
                                            ),
                                          ],
                                        ),
                                    if (record != null) ...[
                                      const SizedBox(height: 6),
                                      Row(
                                        children: [
                                          Expanded(child: Text('Total: ₹${total.toStringAsFixed(0)}',
                                              style: const TextStyle(fontSize: 13))),
                                          Expanded(child: Text('Paid: ₹${paidAmt.toStringAsFixed(0)}',
                                              style: const TextStyle(fontSize: 13, color: Colors.green))),
                                          Expanded(child: Text('Dues: ₹${pending.toStringAsFixed(0)}',
                                              style: TextStyle(
                                                  fontSize: 13,
                                                  fontWeight: FontWeight.bold,
                                                  color: pending > 0 ? Colors.red : Colors.green))),
                                        ],
                                      ),
                                    ],
                                    const SizedBox(height: 8),
                                    Row(
                                      mainAxisAlignment: MainAxisAlignment.end,
                                      children: [
                                        if (record != null && pending > 0)
                                          IconButton.filledTonal(
                                            onPressed: () => _sendFeesToWhatsApp(s, record),
                                            icon: const Icon(Icons.message, size: 18),
                                            tooltip: 'Send WhatsApp',
                                            style: IconButton.styleFrom(backgroundColor: Colors.green),
                                          ),
                                        if (record != null)
                                          TextButton.icon(
                                            onPressed: () => _showHistoryDialog(s, record),
                                            icon: const Icon(Icons.history, size: 16),
                                            label: const Text('History'),
                                          ),
                                        const SizedBox(width: 8),
                                        FilledButton.icon(
                                          onPressed: () => _recordPaymentDialog(s, record),
                                          icon: const Icon(Icons.payment, size: 16),
                                          label: Text(record == null ? 'Setup & Collect' : 'Collect Fee'),
                                        ),
                                      ],
                                    ),
                                  ],
                                ),
                              ),
                            );
                          },
                        ),
                      ),
                    ],
                  );
                },
              );
            },
          ),
        ),
      ],
    );
      },
    );
  }
}

class _FeeChip extends StatelessWidget {
  const _FeeChip({required this.label, required this.count, required this.color});
  final String label;
  final int count;
  final Color color;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 6),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.1),
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: color),
      ),
      child: Column(
        children: [
          Text('$count', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 18, color: color)),
          Text(label, style: TextStyle(fontSize: 11, color: color)),
        ],
      ),
    );
  }
}

